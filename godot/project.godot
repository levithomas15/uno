; UNO - Projektdatei fuer Godot 4.3
; Im Editor oeffnen: godot --path godot   (oder den Ordner im Projektmanager waehlen)

config_version=5

[application]

config/name="UNO"
config/description="UNO mit den Originalkarten: allein gegen Bots, abwechselnd auf einem Geraet oder online zu 2 bis 10."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.106, 0.369, 0.227, 1)

[gui]

theme/default_font_multichannel_signed_distance_field=true
